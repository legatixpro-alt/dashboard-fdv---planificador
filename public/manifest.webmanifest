{
  "id": "/",
  "name": "Dashboard FDV - Planificador y Cobros",
  "short_name": "FDV Cobros",
  "description": "Dashboard de Fuerza de Ventas con recepción directa de soportes de pago desde WhatsApp.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0a0a0a",
  "theme_color": "#dc2626",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target-cobro",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "comprobante",
          "accept": [
            "image/*",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".pdf"
          ]
        }
      ]
    }
  }
}
